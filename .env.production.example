# Copy to `.env.production` on the server and fill in real values.
# This file is read by the app container at runtime (docker-compose `env_file`).

# REQUIRED — Supabase project credentials (Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# REQUIRED — AI Gateway API key for Claude/GPT model routing
AI_GATEWAY_API_KEY=your-api-key

# REQUIRED — public URL of this deployment (used for OAuth redirects, CSP, sitemap)
NEXT_PUBLIC_APP_URL=https://your-subdomain.example.com

# OPTIONAL — secret for seeding demo data in production (leave blank to disable)
SEED_SECRET=
