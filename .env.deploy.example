# Copy to `.env` next to docker-compose.yml on the server.
# These drive docker-compose itself (build args + Traefik labels) — separate
# from `.env.production`, which the running app reads.

DOMAIN=subdomain.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_CERT_RESOLVER=letsencrypt

# Same public values as .env.production — needed here too because they must
# be baked in at `next build` time (build args), not just runtime.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=https://subdomain.example.com
